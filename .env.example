# ==========================================
# Backend Environment Variables (Render)
# ==========================================
# MongoDB Connection String (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus-skill-exchange?retryWrites=true&w=majority

# Port for the Express server (Render sets PORT automatically)
PORT=5000

# Secret key for JWT token generation & verification
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# Frontend Environment Variables (Vercel)
# ==========================================
# Render backend URL (e.g., https://campus-skill-exchange-backend.onrender.com)
# Leave blank for local development to use Vite's built-in proxy
VITE_API_URL=

